# ============================================
# Jarvis Configuration Template
# ============================================
# Copy this file to .env and adjust values as needed.
# Values shown below represent the application defaults.

# --- Application & Logging ---
JARVIS_APP_NAME=Jarvis
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_TO_FILE=true
# JARVIS_LOG_DIR=logs

# --- Data & Storage Paths ---
# JARVIS_DATA_DIR=data
# JARVIS_DB_PATH=data/memory.db

# --- Speech Recognition ---
JARVIS_SPEECH_LANGUAGE=en-US
JARVIS_SPEECH_TIMEOUT=5
JARVIS_SPEECH_PHRASE_LIMIT=15

# --- Text-to-Speech (TTS) ---
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0

# --- Wake Word Detection ---
JARVIS_WAKE_WORD="hey jarvis"
JARVIS_WAKE_WORD_TIMEOUT=5
JARVIS_WAKE_WORD_ENABLED=true

# --- LLM Brain Provider Selection ---
# Choose: "gemini" or "groq" (auto-detected based on provided keys if omitted)
JARVIS_BRAIN_PROVIDER=gemini

# --- Google Gemini Brain ---
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
JARVIS_GEMINI_MODEL=gemini-2.5-flash
JARVIS_GEMINI_MAX_TOKENS=150

# --- Groq Brain ---
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
JARVIS_GROQ_MODEL=qwen/qwen3.8-27b
JARVIS_GROQ_MAX_TOKENS=150
